---
import type { Photo } from '../../content/stories';

interface Props {
  photo: Photo;
  sizes: string;
  eager?: boolean;
  zoom?: boolean;
  class?: string;
}

const { photo, sizes, eager = false, zoom = true, class: className } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const src = (width: number) => `${base}/img/${String(photo.n).padStart(2, '0')}-${width}.webp`;
---
<img
  class={className}
  src={src(photo.widths[1] ?? photo.widths[0])}
  srcset={photo.widths.map((width) => `${src(width)} ${width}w`).join(', ')}
  sizes={sizes}
  width={Math.round(photo.w)}
  height={Math.round(photo.h)}
  alt={photo.alt}
  loading={eager ? 'eager' : 'lazy'}
  fetchpriority={eager ? 'high' : undefined}
  decoding="async"
  data-zoom={zoom ? src(photo.widths.at(-1)!) : undefined}
/>
