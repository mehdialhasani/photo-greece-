---
import { getStories, type Lang } from '../../content/stories';
import { ui } from '../../content/ui';

interface Props {
  lang: Lang;
  // Which page this frame holds, for the language switch and the current link
  page?: 'legal' | 'about';
}

// Frame for the legal notice: the menu bar of the stories, the text, the footer
const { lang, page = 'legal' } = Astro.props;
const pathKey = page === 'legal' ? 'legalPath' : 'aboutPath';
const t = ui[lang];
const stories = getStories(lang);
const otherLang = lang === 'de' ? 'en' : 'de';
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---
<header class="bar solid">
  <a class="bar-home" href={base + t.homePath} aria-label={t.home}>MA</a>
  <nav class="bar-nav" aria-label={t.stories}>
    {stories.map((s) => <a href={base + s.path}>{t[s.slug as 'wildfires' | 'olives' | 'demo']}</a>)}
    <a class="bar-about" href={base + t.aboutPath} aria-current={page === 'about' ? 'page' : undefined}>{t.about}</a>
    <a class="bar-lang" href={base + ui[otherLang][pathKey]} hreflang={otherLang} aria-label={t.otherLabel}>{t.other}</a>
  </nav>
</header>
<main class="legal">
  <slot />
</main>
<footer class="foot">
  <span>© Mehdi Al-Hasani</span>
  <a href={base + t.legalPath} aria-current={page === 'legal' ? 'page' : undefined}>{t.legal}</a>
</footer>
