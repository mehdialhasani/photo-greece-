---
import type { Photo } from '../../content/stories';
import Pic from './Pic.astro';

interface Props {
  photo: Photo;
  detail: Photo;
}

// The sign in photo 2 is cut off at the right edge after "Αλεξα" and "Alexa". The missing
// letters continue the lettering outside the picture and appear one by one while scrolling.
// Positions are measured on the photo, in percent of its width (cqw): left edge of the first
// cut-off letter, baseline and x-height of each line.
// Clicking the sign opens a close-up in the same frame.
const lines = [
  { rest: 'νδρουπολη', left: 93.9, baseline: 60.6, lang: 'el' },
  { rest: 'ndroupoli', left: 89.5, baseline: 81.9, lang: 'de' },
];
// Both lines are written at the same time, letter by letter
const longest = Math.max(...lines.map((line) => line.rest.length));
const { photo, detail } = Astro.props;
---
<figure class="sign" data-sign style={`--letters:${longest}`}>
  <button type="button" class="sign-photo" aria-pressed="false" aria-label="Detail ansehen">
    <Pic photo={photo} sizes="(max-width: 767px) 50vw, 420px" zoom={false} />
    <Pic photo={detail} sizes="(max-width: 767px) 50vw, 420px" zoom={false} class="sign-detail" />
    {lines.map((line) => (
      <span class="sign-line" lang={line.lang} style={`--left:${line.left};--baseline:${line.baseline}`} aria-hidden="true">
        <span class="sign-word">
          {[...line.rest].map((letter, i) => <span style={`--i:${i}`}>{letter}</span>)}
        </span>
      </span>
    ))}
  </button>
  <figcaption>
    <span class="sign-hint">Detail ansehen</span>
  </figcaption>
  <h2 class="sr-only">Αλεξανδρουπολη / Alexandroupoli</h2>
</figure>
