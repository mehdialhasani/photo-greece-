---
import 'leaflet/dist/leaflet.css';

type View = { center: [number, number]; zoom: number; label: string };
interface Props {
  label: string;
  from: View;
  to: View;
  pin?: [number, number];
  // Still of the start view (public/img/map-STILL.webp), shown until the satellite tiles arrive
  still: string;
}

// Satellite map that zooms smoothly from a wide view into the area once it is on screen.
// Leaflet and the tiles load in the browser when the map comes near (see setupMaps).
const { label, from, to, pin, still } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<section class="map" data-map={JSON.stringify({ from, to, pin })} aria-label={label} style={`--still:url(${base}/img/map-${still}.webp)`} data-reveal>
  <div class="map-canvas"></div>
  <div class="map-ui">
    <p class="kicker map-label" aria-live="polite">{from.label}</p>
    <button type="button" class="map-again" aria-label="Nochmal heranzoomen" hidden><span aria-hidden="true">↻</span></button>
  </div>
</section>
