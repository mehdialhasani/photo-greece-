     "html": "<p style=\"line-height:25px;text-align:left;padding-bottom:10px\"><span style=\"font-family:'Inter';font-weight:400;font-style:normal;font-size:18px;color:rgba(255,255,255,1)\">Die EU-Kommission meldete über 175.000 Hektar verbranntes Land. </span></p><p style=\"line-height:25px;text-align:left;padding-bottom:10px\"><span style=\"font-family:'Inter';font-weight:400;font-style:normal;font-size:18px;color:rgba(255,255,255,1)\">Etwa zwei Dutzend Menschen sind den Bränden zum Opfer gefallen.</span></p>",
     "fontSize": 18
    },
