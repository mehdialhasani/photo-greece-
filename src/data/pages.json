     "anims": [],
     "html": "<p style=\"line-height:26px;text-align:left\"><span style=\"font-size:18px;font-family:'Inter';font-weight:400;font-style:normal;color:rgba(125,131,125,1)\">Eine Analyse der EFFIS-Daten (European Forest Fire Information System) bestätigt, dass in Griechenland im Jahr 2023 ca. 174.770 Hektar Land verbrannt sind. </span></p><p style=\"line-height:26px;text-align:left\">&nbsp;</p><p style=\"line-height:26px;text-align:left\"><span style=\"font-size:18px;font-family:'Inter';font-weight:400;font-style:normal;color:rgba(125,131,125,1)\">Die Untersuchungen beziffern die Schadenskosten auf über 1,8 Milliarden Euro.</span></p>",
