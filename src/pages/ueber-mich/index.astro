---
import DraftBase from '../../layouts/DraftBase.astro';
import Legal from '../../components/draft/Legal.astro';
import { getStories } from '../../content/stories';

const stories = getStories('de');
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---
<DraftBase title="Über mich | Mehdi Al-Hasani" variant="a">
  <Legal lang="de" page="about">
    <h1>Über mich</h1>
    <p>Ich bin Mehdi Al-Hasani und lebe in Hannover. Hier zeige ich meine Fotostorys aus Griechenland: über die Waldbrände und über eine Olivenpresse in Makri.</p>

    <h2>Arbeiten</h2>
    <ul>
      {stories.map((s) => <li><a href={base + s.path}>{s.title.join(' | ')}</a> – {s.kicker}</li>)}
    </ul>

    <h2>Kontakt</h2>
    <p><a href="mailto:mehdi.alhasani@gmail.com">mehdi.alhasani@gmail.com</a></p>
  </Legal>
</DraftBase>
