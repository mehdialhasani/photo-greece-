---
import DraftBase from '../../layouts/DraftBase.astro';
import Legal from '../../components/draft/Legal.astro';
import { getStories } from '../../content/stories';

const stories = getStories('de');
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---
<DraftBase title="Über mich | Mehdi Al-Hasani" variant="a">
  <Legal lang="de" page="about">
    <img class="portrait" src={base + 'img/portrait-707.webp'} srcset={`${base}img/portrait-400.webp 400w, ${base}img/portrait-707.webp 707w`} sizes="(max-width: 767px) 60vw, 300px" width="707" height="1044" alt="Porträt von Mehdi Al-Hasani" />
    <h1>Über mich</h1>

    <h2>Arbeiten</h2>
    <ul>
      {stories.map((s) => <li><a href={base + s.path}>{s.title.join(' | ')}</a></li>)}
    </ul>

    <h2>Kontakt</h2>
    <p><a href="mailto:mehdi.alhasani@gmail.com">mehdi.alhasani@gmail.com</a></p>
  </Legal>
</DraftBase>
