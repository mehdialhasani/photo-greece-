---
import DraftBase from '../../../layouts/DraftBase.astro';
import Legal from '../../../components/draft/Legal.astro';
import { getStories } from '../../../content/stories';

const stories = getStories('en');
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---
<DraftBase title="About | Mehdi Al-Hasani" variant="a" lang="en">
  <Legal lang="en" page="about">
    <h1>About</h1>
    <p>I am Mehdi Al-Hasani and I live in Hanover, Germany. This is where I show my photo stories from Greece: about the wildfires and about an olive press in Makri.</p>

    <h2>Work</h2>
    <ul>
      {stories.map((s) => <li><a href={base + s.path}>{s.title.join(' | ')}</a> – {s.kicker}</li>)}
    </ul>

    <h2>Contact</h2>
    <p><a href="mailto:mehdi.alhasani@gmail.com">mehdi.alhasani@gmail.com</a></p>
  </Legal>
</DraftBase>
